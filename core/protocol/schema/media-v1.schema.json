{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:newim:protocol:media:v1",
  "title": "NewIM media metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mediaKey", "kind", "contentType", "size", "sha256"],
  "properties": {
    "mediaKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "kind": {
      "enum": ["image", "video", "audio", "file"]
    },
    "contentType": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,62}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
    },
    "size": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,7}|100[0-9]{6}|101[0-9]{6}|102[0-9]{6}|103[0-9]{6}|104[0-7][0-9]{5}|1048[0-4][0-9]{4}|10485[0-6][0-9]{3}|104857[0-5][0-9]{2}|104857600)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "x-wire-profile": {
    "maxBytes": 4096,
    "closedObject": true,
    "rejectBinary": true,
    "rejectExpiringUrls": true
  }
}
